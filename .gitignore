# python
__pycache__/
*.pyc

# local dev artifacts
*.bak
/deploy.log
/last-shot.png

# local deployment config (real host/IP) — the .dist template stays committed
/pisynth.conf

# aiball dev-tooling state (local to the maintainer's workflow)
/.aiball.yaml
/.aiball-session_id
# local MCP server config (machine-specific tooling)
/.mcp.json

# agent/dev project notes — kept local, not published (#286)
/CLAUDE.md

# sideloaded soundfonts (large / possibly licensed) — keep the README
soundfonts/*.sf2
soundfonts/*.sf3

# your own MIDI files (#2421): anything in midi/ (subfolders too), except its README
/midi/*
!/midi/README.md

# host-local one-shot migrations (per-device, not shipped) — run by apply.sh
/local-migrations/

# web companion (#659): Svelte sources build into web/static (committed)
/web/app/node_modules/
/dev/certs/
/dev/state/
