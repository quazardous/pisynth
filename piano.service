[Unit]
Description=Grand Piano (fluidsynth + USB MIDI)
After=sound.target systemd-udev-settle.service
Wants=sound.target

[Service]
Type=simple
User=pi
Group=audio
SupplementaryGroups=audio
ExecStart=/usr/local/bin/start-piano.sh
Restart=always
RestartSec=3
# Give the kernel a moment to enumerate USB devices on cold boot
ExecStartPre=/bin/sleep 2

# Real-time scheduling for fluidsynth's audio threads.
# LimitRTPRIO grants the capability to request SCHED_FIFO up to prio 95.
# LimitMEMLOCK lets fluidsynth lock memory pages (avoids paging glitches).
# fluidsynth itself picks its RT prio (default 60).
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=2
# (No CPUAffinity: the Pi 3B+ has 4 identical Cortex-A53 cores — unlike the
# NanoPi's RK3399 big.LITTLE, there's no faster cluster to pin to.)
# Safety cap so a runaway synth can't lock up the touch UI (#282/#311): on the BT
# output path fluidsynth runs NON-realtime (see start-piano.sh), so CPUQuota bounds it
# — 200% = max 2 of the 4 cores, leaving the UI/system responsive. (RT tasks on the
# low-latency ALSA-direct path aren't bounded by cgroup quota, but a real DAC paces
# them, so they don't run away.)
CPUQuota=200%

# Logs to journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
